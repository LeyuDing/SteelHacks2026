value = 0.0
# Placeholder fill sprite: a plain solid-color texture (see the Gradient /
# GradientTexture2D sub-resources above) - swap for real "mana meter" art
# when available. Deliberately not icon.svg: its base color is dark navy,
# which stayed nearly invisible against the dark Frame panel even with
# modulate alpha, since modulate can only darken/tint a texture, not
# brighten it - a plain bright texture makes the alpha actually read.
texture_progress = SubResource("GradientTexture2D_levelbar_fill")
fill_mode = 3
# Without this, TextureProgressBar draws texture_progress at its native
# pixel size instead of stretching it to fill this control's rect, so the
# bar would render as a tiny square instead of a tall vertical bar.
nine_patch_stretch = true
script = ExtResource("5_levelbar")

